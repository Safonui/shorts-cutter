# ---------------------------------------------------------------------------
# Что НЕ попадает в git. Без этого файла «git add .» утащил бы на GitHub
# около 1,5 ГБ: окружение, кэш модели и готовые сборки.
# ---------------------------------------------------------------------------

# Окружение проекта и кэш моделей — восстанавливаются установкой, в git не нужны
.venv/
.hf-cache/

# Кэш Python
__pycache__/
*.py[cod]

# Результаты сборок и распакованные копии приложения
build/
dist/
store/dist/
_app/
_install_test/
*.spec

# Однофайловый лаунчер «Нарезка Shorts.cmd» — это тоже сборка (внутри zip
# со всем приложением, 220 КБ), пересобирается командой make_launcher.py.
# Нужен он в репозитории — снимите решётку и сделайте: git add -f "Нарезка Shorts.cmd"
#Нарезка Shorts.cmd

# Журналы и пользовательские настройки
shorts_cutter.log
*.log
settings.json

# Служебный мусор Windows и редакторов
Thumbs.db
desktop.ini
.idea/
.vscode/
*.tmp
*.bak
